# Mobile app
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Local API
API_PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
DATABASE_URL=postgresql://YOUR_LOCAL_USER@127.0.0.1:5432/book_exchange_local
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_TTL=7d
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional integrations. Keep these server-side; never prefix them with EXPO_PUBLIC_.
GOOGLE_BOOKS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=bookexchange://success
STRIPE_CANCEL_URL=bookexchange://cancel
