{
  "name": "book-exchange-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS='--max_old_space_size=8192' expo start --clear",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n api,app -c cyan,magenta \"npm:dev:api\" \"npm:dev\"",
    "db:setup": "tsx server/scripts/setup-db.ts",
    "db:reset": "tsx server/scripts/reset-db.ts",
    "test:server": "tsx --test server/test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "build:web": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS='--max_old_space_size=8192' expo export --platform web",
    "lint": "expo lint",
    "analyze": "npx source-map-explorer 'web-build/static/js/*.js'"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/roboto-slab": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@lucide/lab": "^0.1.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@stripe/stripe-react-native": "0.64.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react-native": "^1.27.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "stripe": "^22.3.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.0",
    "source-map-explorer": "^2.5.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
