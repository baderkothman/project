{
  "name": "book-exchange-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS='--max_old_space_size=8192' expo start --clear",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n api,app -c cyan,magenta \"npm:dev:api\" \"npm:dev\"",
    "db:setup": "tsx server/scripts/setup-db.ts",
    "db:reset": "tsx server/scripts/reset-db.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "build:web": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS='--max_old_space_size=8192' expo export --platform web",
    "lint": "expo lint",
    "analyze": "npx source-map-explorer 'web-build/static/js/*.js'"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@stripe/stripe-react-native": "0.38.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-blur": "^14.0.3",
    "expo-camera": "^16.0.18",
    "expo-constants": "^17.0.5",
    "expo-font": "~13.0.4",
    "expo-haptics": "^14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "^14.0.2",
    "expo-linking": "^7.0.5",
    "expo-router": "~4.0.22",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "^2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "^14.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react-native": "^0.475.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "^3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.12.5",
    "stripe": "^22.3.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.72.8",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
